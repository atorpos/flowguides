        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Extracting Test Variables">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// Groovy, not JavaScript: Nashorn was removed in Java 15, so a
// scriptLanguage of &quot;javascript&quot; throws on the Java 17 this runs on.
def link = vars.get(&apos;LOADTESTLINK&apos;)
if (link == null || link.trim().isEmpty()) {
    throw new IllegalStateException(
        &apos;LOADTESTLINK is empty. Pass -Jloadtestlink=&quot;https://CUSTOMERID.queue-it.net?c=CUSTOMERID&amp;e=WAITINGROOMID&quot; &apos; +
        &apos;(take it from the Queue-it Load Test details page). Test B cannot run without it.&apos;)
}
def cm = (link =~ /[?&amp;]c=([^&amp;]+)/)
def em = (link =~ /[?&amp;]e=([^&amp;]+)/)
if (!cm.find() || !em.find()) {
    throw new IllegalStateException(&apos;LOADTESTLINK must contain both c= and e= parameters, got: &apos; + link)
}
def q = link.indexOf(&apos;?&apos;)
def base = (q &gt;= 0 ? link.substring(0, q) : link)
def proto = base.startsWith(&apos;http://&apos;) ? &apos;http&apos; : &apos;https&apos;
def host = base.replaceFirst(/^https?:\/\//, &apos;&apos;).replaceAll(/\/.*$/, &apos;&apos;)

vars.put(&apos;QUEUEITDOMAIN&apos;, host)
vars.put(&apos;CUSTOMERID&apos;, cm.group(1))
vars.put(&apos;EVENTID&apos;, em.group(1))
vars.put(&apos;PROTOCOL&apos;, proto)
vars.put(&apos;PORT&apos;, proto == &apos;http&apos; ? &apos;80&apos; : &apos;443&apos;)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
